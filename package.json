{
	"name": "yggdrasil-ft",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"license": "MIT",
	"author": "Ivan Kryvosheyev",
	"description": "Offline-first family-tree builder with a research TODO board (local-only data)",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"probe": "node scripts/pwa-probe.mjs",
		"probe:ui": "node scripts/ui-probe.mjs",
		"verify": "npm run lint && npm run typecheck && npm run test && npm run build",
		"probe:pages": "node scripts/mount-probe.mjs"
	},
	"dependencies": {
		"@preact/signals": "^2.11.3",
		"preact": "^10.29.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@preact/preset-vite": "^2.10.6",
		"@types/node": "^26.6.5",
		"typescript": "^6.0.3",
		"vite": "^7.3.7",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5"
	}
}
